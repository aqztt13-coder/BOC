# GEMINI_API_KEY: Optional Gemini API key injected from Secrets if AI features are enabled.
GEMINI_API_KEY=""

# APP_URL: Public URL of the deployed BOC HRMS application (used in QR verification links).
APP_URL=""

# PostgreSQL / Cloud SQL configuration (either DATABASE_URL or individual SQL_* variables)
DATABASE_URL=""
SQL_HOST=""
SQL_PORT="5432"
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional comma-separated list of explicit bootstrap HR administrator emails (server-side only, never hardcoded)
ADMIN_BOOTSTRAP_EMAILS=""
